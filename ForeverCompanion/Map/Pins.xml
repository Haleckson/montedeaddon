<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\..\FrameXML\UI.xsd">
    <!--
        Forever Companion world map pin template.
        Map canvas pin pools need a named virtual template; behavior lives in
        ForeverCompanionMapPinMixin (Map/Pins.lua).
    -->
    <Frame name="ForeverCompanionMapPinTemplate" mixin="ForeverCompanionMapPinMixin" enableMouse="true" virtual="true">
        <Size x="12" y="12"/>
        <Scripts>
            <OnLoad method="OnLoad"/>
        </Scripts>
    </Frame>
</Ui>
